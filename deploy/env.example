# /opt/app/.env no LXC draw-prd. Os valores reais ficam no Vaultwarden, nunca no git.

# Endereço público, sem barra no fim.
DRAW_PUBLIC_URL=https://draw.oute.pro
# IP:porta do LXC onde o oauth2-proxy atende o nginx do host.
DRAW_PUBLICAR=10.0.0.0:3830

# Tenant no oute-supabase-db (ADR-0003): papel app_draw_prd, schema draw_prd.
DRAW_DATABASE_URL=postgres://app_draw_prd:SENHA@HOST:5432/postgres
DRAW_DB_SCHEMA=draw_prd

# openssl rand -hex 32
DRAW_SECRET=
# Quem é admin no app (os demais emails da lista entram como editor).
DRAW_ADMIN_EMAILS=voce@exemplo.com
# editor | viewer: papel de quem entra pela primeira vez.
DRAW_DEFAULT_ROLE=editor

# Login Google (cliente OAuth próprio do draw, callback DRAW_PUBLIC_URL/oauth2/callback).
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Opcional: texto para diagrama com IA. Sem a chave, o recurso fica desligado.
# ANTHROPIC_API_KEY=
# DRAW_AI_MODEL=claude-opus-5-5

# Opcional: servidores ICE das chamadas de voz (JSON RTCIceServer). O padrão é um STUN
# público; atrás de NAT restritivo é preciso um TURN.
# DRAW_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
